# OpenRouter (optional). The public model listing works without a key, but a key
# raises the rate limit. The key is sent as a bearer token.
OPENROUTER_API_KEY=

# NVIDIA NIM (integrate.api.nvidia.com) credentials.
# Required for polling the NIM model list. Any one of these is accepted.
NVIDIA_API_KEY=
# NGC_API_KEY=

# Google AI Studio (Gemini) API key
GOOGLE_API_KEY=
# Accepted alias:
GEMINI_API_KEY=

# Ollama Cloud API key (create at https://ollama.com/settings/keys)
# Preferred env var name:
OLLAMA_API_KEY=
# Accepted alias:
OLLAMA_CLOUD_API_KEY=

# Novita AI API key (create at https://novita.ai/settings)
# Preferred env var name:
NOVITA_API_KEY=
# Accepted aliases:
NOVITA_KEY=
NOVITA_AI_API_KEY=
